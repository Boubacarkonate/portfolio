---
import Layout from '../../../layouts/Layout.astro';

// Glob pour le rendu du composant (disponible à l'évaluation du module).
const studies = import.meta.glob('../../../etudes-de-cas/en/*.md', { eager: true });

export function getStaticPaths() {
  // getStaticPaths est extrait par Astro : il doit être autonome (glob interne).
  const all = import.meta.glob('../../../etudes-de-cas/en/*.md', { eager: true });
  return Object.keys(all).map((path) => ({ params: { slug: path.split('/').pop().replace('.md', '') } }));
}

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/'); // préfixe du sous-dossier (se termine par "/")
const { slug } = Astro.params;
const entry = Object.entries(studies).find(([path]) => path.endsWith(`/${slug}.md`));
const study = entry[1];
const { Content, frontmatter } = study;

const title = `${frontmatter.title} | Case study — Boubacar Konaté`;
const description = frontmatter.description;
const dateISO = new Date(frontmatter.date).toISOString();
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: frontmatter.title,
  description: frontmatter.description,
  datePublished: dateISO,
  author: { '@type': 'Person', name: 'Boubacar Konaté' },
});
---

<Layout title={title} description={description} lang="en">
  <script type="application/ld+json" slot="head" set:html={jsonLd} />
  <article class="article">
    <div class="container article-inner">
      <p class="article-back"><a href={`${base}en/etudes-de-cas/`}><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> All case studies</a></p>
      <p class="kicker"><span class="kicker-num">★</span><span>Case study</span></p>
      <h1>{frontmatter.title}</h1>
      <dl class="case-facts">
        {frontmatter.client && <div><dt>Client</dt><dd>{frontmatter.client}</dd></div>}
        {frontmatter.type && <div><dt>Type</dt><dd>{frontmatter.type}</dd></div>}
        {frontmatter.client && frontmatter.secteur && <div><dt>Sector</dt><dd>{frontmatter.secteur}</dd></div>}
        {frontmatter.role && <div><dt>Role</dt><dd>{frontmatter.role}</dd></div>}
        {frontmatter.prestation && <div><dt>Service</dt><dd>{frontmatter.prestation}</dd></div>}
        <div><dt>Technologies</dt><dd>{frontmatter.techno.join(', ')}</dd></div>
        {frontmatter.resultat && <div><dt>Result</dt><dd>{frontmatter.resultat}</dd></div>}
      </dl>
      {(frontmatter.url || frontmatter.repo) && (
        <p class="case-link">
          {frontmatter.url && <a href={frontmatter.url} class="btn btn-ghost" target="_blank" rel="noopener noreferrer"><span>Visit the site ({frontmatter.urlLabel})</span><i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i></a>}
          {frontmatter.repo && <a href={frontmatter.repo} class="btn btn-ghost" target="_blank" rel="noopener noreferrer"><span>View the code</span><i class="fa-brands fa-github" aria-hidden="true"></i></a>}
        </p>
      )}
      <div class="article-body">
        <Content />
      </div>
      <p class="article-cta"><a href={`${base}en/#contact`} class="btn btn-accent">Get in touch <i class="fa-solid fa-arrow-right btn-arrow" aria-hidden="true"></i></a></p>
    </div>
  </article>
</Layout>
