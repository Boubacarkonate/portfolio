---
import Layout from '../../../layouts/Layout.astro';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/'); // préfixe du sous-dossier (se termine par "/")
const studies = Object.entries(import.meta.glob('../../../etudes-de-cas/en/*.md', { eager: true }))
  .map(([path, mod]) => ({ slug: path.split('/').pop().replace('.md', ''), ...mod.frontmatter }))
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

const title = 'Case studies — client web projects | Boubacar Konaté';
const description = 'Real web projects: the initial need, the delivered solution and the result. By Boubacar Konaté, full stack web developer in Paris.';
---

<Layout title={title} description={description} lang="en">
  <section class="section">
    <div class="container">
      <header class="section-head reveal">
        <p class="kicker"><span class="kicker-num">★</span><span>Case studies</span></p>
        <h1 class="section-title">Real projects, from need to result</h1>
      </header>
      <ul class="article-list">
        {studies.map((p) => (
          <li class="article-card reveal">
            <a href={`${base}en/etudes-de-cas/${p.slug}/`}>
              <span class="case-tag">{p.secteur}</span>
              <h2>{p.title}</h2>
              <p>{p.description}</p>
              <span class="article-more">Read the case study <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Layout>
