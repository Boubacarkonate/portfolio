---
import Layout from '../../layouts/Layout.astro';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/'); // préfixe du sous-dossier (se termine par "/")
const studies = Object.entries(import.meta.glob('../../etudes-de-cas/*.md', { eager: true }))
  .map(([path, mod]) => ({ slug: path.split('/').pop().replace('.md', ''), ...mod.frontmatter }))
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

const title = 'Études de cas — projets web clients | Boubacar Konaté';
const description = 'Des projets web concrets : le besoin de départ, la solution livrée et le résultat. Par Boubacar Konaté, développeur web full stack à Paris.';
---

<Layout title={title} description={description} lang="fr">
  <section class="section">
    <div class="container">
      <header class="section-head reveal">
        <p class="kicker"><span class="kicker-num">★</span><span>Études de cas</span></p>
        <h1 class="section-title">Des projets concrets, du besoin au résultat</h1>
      </header>
      <ul class="article-list">
        {studies.map((p) => (
          <li class="article-card reveal">
            <a href={`${base}etudes-de-cas/${p.slug}/`}>
              <span class="case-tag">{p.secteur}</span>
              <h2>{p.title}</h2>
              <p>{p.description}</p>
              <span class="article-more">Lire l'étude de cas <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Layout>
